{
  "$defs": {
    "ExactImportedDecimal": {
      "additionalProperties": false,
      "properties": {
        "scale": {
          "maximum": 30,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "unscaled_units": {
          "pattern": "^[1-9][0-9]{0,37}$",
          "title": "Unscaled Units",
          "type": "string"
        }
      },
      "required": [
        "unscaled_units",
        "scale"
      ],
      "title": "ExactImportedDecimal",
      "type": "object"
    },
    "HistoricalInvestmentActivityKind": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "HistoricalInvestmentActivityKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.track-anywhere.dev/v2/events/HistoricalInvestmentActivityImported.v1.json",
  "additionalProperties": false,
  "properties": {
    "activity_kind": {
      "$ref": "#/$defs/HistoricalInvestmentActivityKind"
    },
    "cash_amount": {
      "$ref": "#/$defs/ExactImportedDecimal"
    },
    "nav": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactImportedDecimal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quantity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactImportedDecimal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "settlement_asset_code": {
      "pattern": "^[A-Z][A-Z0-9._-]{0,15}$",
      "title": "Settlement Asset Code",
      "type": "string"
    },
    "source_account_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Account Id",
      "type": "string"
    },
    "source_event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Event Id",
      "type": "string"
    },
    "source_row_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Row Hash",
      "type": "string"
    },
    "source_version": {
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    }
  },
  "required": [
    "source_event_id",
    "source_account_id",
    "activity_kind",
    "settlement_asset_code",
    "cash_amount",
    "source_version",
    "source_row_hash"
  ],
  "title": "HistoricalInvestmentActivityImported",
  "type": "object",
  "x-event-type": "HistoricalInvestmentActivityImported",
  "x-schema-version": 1
}
