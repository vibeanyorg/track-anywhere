{
  "$defs": {
    "ExactImportedDecimal": {
      "additionalProperties": false,
      "properties": {
        "scale": {
          "maximum": 30,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "unscaled_units": {
          "pattern": "^[1-9][0-9]{0,37}$",
          "title": "Unscaled Units",
          "type": "string"
        }
      },
      "required": [
        "unscaled_units",
        "scale"
      ],
      "title": "ExactImportedDecimal",
      "type": "object"
    },
    "HistoricalReportingLineKind": {
      "enum": [
        "fx_exchange",
        "fx_fee"
      ],
      "title": "HistoricalReportingLineKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.track-anywhere.dev/v2/events/HistoricalReportingLineImported.v1.json",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "$ref": "#/$defs/ExactImportedDecimal"
    },
    "asset_code": {
      "pattern": "^[A-Z][A-Z0-9._-]{0,15}$",
      "title": "Asset Code",
      "type": "string"
    },
    "line_kind": {
      "$ref": "#/$defs/HistoricalReportingLineKind"
    },
    "position": {
      "minimum": 0,
      "title": "Position",
      "type": "integer"
    },
    "source_line_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Line Id",
      "type": "string"
    },
    "source_row_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Row Hash",
      "type": "string"
    },
    "source_transaction_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Transaction Id",
      "type": "string"
    },
    "source_version": {
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    },
    "transaction_id": {
      "format": "uuid",
      "title": "Transaction Id",
      "type": "string"
    }
  },
  "required": [
    "source_line_id",
    "source_transaction_id",
    "transaction_id",
    "line_kind",
    "position",
    "asset_code",
    "amount",
    "source_version",
    "source_row_hash"
  ],
  "title": "HistoricalReportingLineImported",
  "type": "object",
  "x-event-type": "HistoricalReportingLineImported",
  "x-schema-version": 1
}
