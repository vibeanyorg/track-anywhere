{
  "$defs": {
    "HistoricalCategoryActivityKind": {
      "enum": [
        "create",
        "reclassify"
      ],
      "title": "HistoricalCategoryActivityKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.track-anywhere.dev/v2/events/HistoricalCategoryActivityImported.v1.json",
  "additionalProperties": false,
  "properties": {
    "activity_kind": {
      "$ref": "#/$defs/HistoricalCategoryActivityKind"
    },
    "affected_line_count": {
      "minimum": 0,
      "title": "Affected Line Count",
      "type": "integer"
    },
    "after_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "After Hash",
      "type": "string"
    },
    "before_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Before Hash",
      "type": "string"
    },
    "rollback_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rollback Hash",
      "type": "string"
    },
    "source_actor_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Actor Hash",
      "type": "string"
    },
    "source_category_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Category Id",
      "type": "string"
    },
    "source_event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Event Id",
      "type": "string"
    },
    "source_row_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Row Hash",
      "type": "string"
    },
    "source_version": {
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    },
    "target_category_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Category Id"
    }
  },
  "required": [
    "source_event_id",
    "activity_kind",
    "source_category_id",
    "affected_line_count",
    "source_actor_hash",
    "source_version",
    "before_hash",
    "after_hash",
    "rollback_hash",
    "source_row_hash"
  ],
  "title": "HistoricalCategoryActivityImported",
  "type": "object",
  "x-event-type": "HistoricalCategoryActivityImported",
  "x-schema-version": 1
}
