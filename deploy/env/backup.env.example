TRACK_ANYWHERE_BACKUP_SERVICE=REPLACE_WITH_DOKPLOY_POSTGRES_APP_NAME
TRACK_ANYWHERE_BACKUP_USER=REPLACE_WITH_DOKPLOY_ADMIN_USER
TRACK_ANYWHERE_BACKUP_DATABASE=track_anywhere
TRACK_ANYWHERE_BACKUP_LOCK_WAIT_TIMEOUT=60000
RCLONE_CONFIG=/etc/track-anywhere/rclone.conf
RCLONE_CONTIMEOUT=30s
RCLONE_TIMEOUT=10m
RCLONE_RETRIES=5
RCLONE_LOW_LEVEL_RETRIES=10
TRACK_ANYWHERE_BACKUP_S3_REMOTE=track-r2-crypt:
TRACK_ANYWHERE_BACKUP_PREFIX=track-anywhere/postgres/six-hourly
TRACK_ANYWHERE_BACKUP_KEEP_LATEST=120
