# Copy this file to deploy/env/prod.env on the deployment host.
# Do not commit deploy/env/prod.env.
TRACK_ANYWHERE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/track_anywhere?sslmode=require
TRACK_ANYWHERE_ALLOWED_ORIGINS=https://ledger.example.com
TRACK_ANYWHERE_PUBLIC_BASE_URL=https://ledger.example.com
TRACK_ANYWHERE_AUTH_SESSION_SECRET=replace-with-a-long-random-secret
TRACK_ANYWHERE_TLS=1
TRACK_ANYWHERE_KEY_PROVIDER=1
TRACK_ANYWHERE_ENCRYPTED_VOLUME=1
TRACK_ANYWHERE_BACKUP_DOC=1
TRACK_ANYWHERE_API=http://127.0.0.1:8000
TRACK_ANYWHERE_SERVICE_URL=http://127.0.0.1:8000
TRACK_ANYWHERE_TOKEN_FILE=/run/secrets/track-anywhere-token
