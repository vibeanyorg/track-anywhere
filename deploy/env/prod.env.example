# Runtime settings for the long-running application container.
# Copy to deploy/env/prod.env on a standalone Docker Compose host.
# Dokploy users should enter the same runtime values in the Application UI.
TRACK_ANYWHERE_IMAGE=ghcr.io/vibeanyorg/track-anywhere-api:nightly-sha-REPLACE_ME
TRACK_ANYWHERE_DATABASE_URL=postgresql+psycopg://track_anywhere_runtime:RUNTIME_PASSWORD@POSTGRES_HOST:5432/track_anywhere
TRACK_ANYWHERE_ALLOWED_ORIGINS=https://ledger.example.com
TRACK_ANYWHERE_PUBLIC_BASE_URL=https://ledger.example.com
TRACK_ANYWHERE_PROJECTION_POLL_SECONDS=2

# Path only: compose mounts the keyring read-only at this fixed container path.
# Keep the JSON keyring at /etc/track-anywhere on the host; never put a raw or
# base64-encoded protected-content key in an environment variable.
TRACK_ANYWHERE_PROTECTED_CONTENT_KEYRING_FILE=/run/secrets/track-anywhere-protected-content-keyring.json

# Host-only bindings used by compose.prod.yaml. Put Traefik/Caddy in front.
TRACK_ANYWHERE_PROD_API_BIND=127.0.0.1
TRACK_ANYWHERE_PROD_API_PORT=8000

# CLI defaults when running outside Compose.
TRACK_ANYWHERE_API=https://ledger.example.com
TRACK_ANYWHERE_SERVICE_URL=https://ledger.example.com
# TRACK_ANYWHERE_API_KEY_FILE=/run/secrets/track-anywhere-api-key
